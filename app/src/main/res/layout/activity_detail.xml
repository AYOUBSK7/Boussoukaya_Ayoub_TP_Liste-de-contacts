<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de détail : photo + champs modifiables + boutons -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gris_fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Photo du contact -->
        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/cercle"
            android:contentDescription="@string/desc_photo"
            android:scaleType="centerCrop" />

        <!-- Nom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/label_nom"
            android:textColor="@color/gris" />

        <EditText
            android:id="@+id/etNom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:inputType="textPersonName|textCapWords" />

        <!-- Prénom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_prenom"
            android:textColor="@color/gris" />

        <EditText
            android:id="@+id/etPrenom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="name"
            android:inputType="textPersonName|textCapWords" />

        <!-- Téléphone + bouton Appeler -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_telephone"
            android:textColor="@color/gris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etTelephone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autofillHints="phone"
                android:inputType="phone" />

            <Button
                android:id="@+id/btnAppeler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/vert"
                android:drawableStart="@drawable/ic_phone"
                android:drawablePadding="6dp"
                android:text="@string/btn_appeler"
                android:textAllCaps="false"
                android:textColor="@color/blanc" />
        </LinearLayout>

        <!-- E-mail + bouton Envoyer un e-mail -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/label_email"
            android:textColor="@color/gris" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="emailAddress"
            android:inputType="textEmailAddress" />

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/bleu"
            android:drawableStart="@drawable/ic_email"
            android:text="@string/btn_email"
            android:textAllCaps="false"
            android:textColor="@color/blanc" />

        <!-- Photo : galerie ou appareil photo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGalerie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/violet"
                android:drawableStart="@drawable/ic_image"
                android:text="@string/btn_galerie"
                android:textAllCaps="false"
                android:textColor="@color/blanc" />

            <Button
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:backgroundTint="@color/violet"
                android:drawableStart="@drawable/ic_camera"
                android:text="@string/btn_camera"
                android:textAllCaps="false"
                android:textColor="@color/blanc" />
        </LinearLayout>

        <!-- Enregistrer / Annuler -->
        <Button
            android:id="@+id/btnEnregistrer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/vert"
            android:text="@string/btn_enregistrer"
            android:textAllCaps="false"
            android:textColor="@color/blanc"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnAnnuler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_annuler"
            android:textAllCaps="false" />

    </LinearLayout>
</ScrollView>
